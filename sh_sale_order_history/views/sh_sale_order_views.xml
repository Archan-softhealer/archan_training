<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_sale_order_list" model="ir.ui.view">
        <field name="name">view.sale.order.list</field> 
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[@name='order_lines']" position="after">
               <page string="Order History" name="Order_history"> 
                 <button name='view_lines_reorder' string='All Lines Recorder' type='object'  groups="sh_sale_order_history.enable_recorder"  /> 
                  <field name="sh_sale_order_history">
                        <list editable="bottom">
                            <field name="check_bool" nolabel="1" ></field>
                            <field name='order_id' string='Sale Order' readonly="1"/>
                            <field name='product_template_id' string='Product' readonly="1"/>
                            <field name='price_unit' string='Price' readonly="1"/>
                            <field name='product_uom_qty' readonly="1"/>
                            <field name='product_uom' readonly="1"/>
                            <field name='discount' readonly="1"/>
                            <field name='price_subtotal' readonly="1"/>
                            <field name='state' readonly="1" string='Status' decoration-success="state == 'sale'"
                            decoration-info="state == 'draft'"
                            decoration-primary="state == 'sent'" widget="badge" />
                            <button name='view_line_order' type='object' icon='fa-eye' />
                            <button name='move_to_line_order' type='object' icon='fa-retweet' groups="sh_sale_order_history.enable_recorder"   />
                        </list>
                    </field>
               </page>
            </xpath>
        </field>
    </record>

</odoo>