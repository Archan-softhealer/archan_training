<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View res.config.settings form -->
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='timesheet_control']" position="after">
               <block title = "Restricted Timesheet">
                  <setting name="restricted_days" help="Set the days to restrict timesheet entry">
                       <field name="restricted_days" />
                  </setting>
               </block>
            </xpath>
        </field>
    </record>

</odoo> 