<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View sh.timesheet View List -->
    <record id="view_sh_timesheet_list" model="ir.ui.view">
        <field name="name">view.sh.timesheet.list</field>
        <field name="model">sh.timesheet</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name='description' />
            </list>
        </field>
    </record>

    <!-- View sh.timesheet form -->
    <record id="view_sh_timesheet_form" model="ir.ui.view">
        <field name="name">view.sh.timesheet.form</field>
        <field name="model">sh.timesheet</field>
        <field name="arch" type="xml">
            <form string="Sh Timesheet">
               <header>
                  <button string='Submit to Manager' name="submit_manager_button" type="object" class="oe_highlight" invisible="state != 'draft' "  groups='time_sheet.timesheet_user_group'/>
                  <button string="Approve" name="approve_button" type="object" class="btn btn-success" invisible="state != 'submitted' " groups='time_sheet.timesheet_manager_group' />
                   <button string="Reject" name="%(action_sh_rejection)d" type="action" class="btn btn-danger" invisible="state != 'submitted' "  groups='time_sheet.timesheet_manager_group'/>
                    <field name="state"  widget='statusbar' statusbar_visible='approved,draft,submitted'/>
                </header>
            <sheet>
             <div class="oe_button_box" name='button_box' position='inside'> <!-- smart button -->
               <button string="Tasks" class="oe_stat_button" icon="fa-star">
                   <div class="o_stat_info">            
                      <field name="count" class="o_stat_value"/>
                       <span class="o_stat_text">Task</span>
                    </div>  
               </button>
              </div>
                <group>
                        <group>
                            <field name="name" />
                            <field name="user_id" />
                            <field name ='description' />
                            <field name="date" />
                            <field name='total_hours' widget='float_time'/>
                        </group>
                        <group>
                            <field name="tag_ids" widget="many2many_tags" />
                            <field name='rejection_reason'/>
                            <field name='task_ids'  widget="many2many_tags" />
                        </group>
                </group>
            </sheet>
            <chatter reload_on_post="True"/>
          </form>
        </field>
    </record>

    <!-- View sh.timesheet search -->
    <record id="view_sh_timesheet_search" model="ir.ui.view">
        <field name="name">view.sh.timesheet.search</field>
        <field name="model">sh.timesheet</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action sh.timesheet -->
    <record id="action_sh_timesheet" model="ir.actions.act_window">
        <field name="name">Sh Timesheet</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.timesheet</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Sh Timesheet.
            </p>
        </field>
    </record>

    <menuitem id="timesheet_root" name="TimeSheet" sequence="3">
      <menuitem
        id="timesheet"
        name="TimeSheet"
        action='action_sh_timesheet'/>

      <menuitem
        id="task"
        name="Task"
        action='action_sh_task'/>

      <menuitem
        id="tags"
        name="Tag"
        action='action_sh_tag'/>  

    </menuitem>

</odoo>
