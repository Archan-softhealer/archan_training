<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View res.config.settings form -->
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app/block[@id='connectors_setting_container']" position="after">
                  <block title='Auto Sale Workflow Settings'  id='auto_workflow_setting_container'>
                     <setting id='sale_order_enable_auto_workflow'>
                         <field name="enable_auto_workflow" widget="upgrade_boolean"/>
                    </setting>
                    <setting id='sale_order_default_workflow' invisible='enable_auto_workflow!=True'>
                         <field name="sh_default_workflow" />
                    </setting>
                  </block>
            </xpath>
        </field>
    </record>

</odoo>