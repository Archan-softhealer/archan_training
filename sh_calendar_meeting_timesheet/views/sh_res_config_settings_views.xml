<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View res.config.settings form -->
    <record id="view_res_config_settings_form" model="ir.ui.view">
        <field name="name">view.res.config.settings.form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="calendar.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='sync_google_calendar_setting']" position="after">
              <setting string="Create Timesheet"  help="Enable timesheet for employees" id="sh_enable_timesheet">
                     <field name="group_enable_timesheet" widget="upgrade_boolean"/>                       
              </setting>
            </xpath>
        </field>
    </record>

</odoo>