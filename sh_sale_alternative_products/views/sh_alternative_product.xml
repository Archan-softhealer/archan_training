<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <record id="view_product_product_form" model="ir.ui.view">
        <field name="name">view.product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook//page[@name='inventory']" position="after">
              <page name="alternative_product" string="Alternative Product" groups='sh_sale_alternative_products.sh_sale_alternative_products_user_group'>
                 <group>
                    <field name="alternative_product" widget = 'many2many_tags' />
                 </group>
              </page>
            </xpath>
        </field>
    </record>

     <record id="inherit_sale_product_view" model="ir.ui.view">
            <field name="name">inherit.sale.product.view</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_product_tree_view" />
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="alternative_product" widget="many2many_tags"  groups='sh_sale_alternative_products.sh_sale_alternative_products_user_group' />
                </field>
            </field>
     </record>

</odoo> 