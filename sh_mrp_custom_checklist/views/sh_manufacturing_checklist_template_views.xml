<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sh_manufacturing_checklist_template_list" model="ir.ui.view">
        <field name="name">view.sh.manufacturing.checklist.template.list</field>
        <field name="model">sh.mrp.checklist.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" nolabel='1'/>
                <field name="name"/>
                <field name="check_list" widget="many2many_tags" />
            </list>
        </field>
    </record>

    <record id="view_sh_manufacturing_checklist_template_form" model="ir.ui.view">
        <field name="name">view.sh.manufacturing.checklist.template.form</field>
        <field name="model">sh.mrp.checklist.template</field>
        <field name="arch" type="xml">
            <form string="Sh Manufacturing Checklist Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                             <field name="company"/>
                        </group>
                        <group>
                            <field name="check_list" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sh_manufacturing_checklist_template_search" model="ir.ui.view">
        <field name="name">view.sh.manufacturing.checklist.template.search</field>
        <field name="model">sh.mrp.checklist.template</field>
        <field name="arch" type="xml">
            <search>
            <field name="check_list" />
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sh_manufacturing_checklist_template" model="ir.actions.act_window">
        <field name="name">Manufacturing Checklist Template</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.mrp.checklist.template</field>
        <field name="view_mode">list,form</field>
    </record>

     <menuitem
        id="sh_manufacturing_checklist_template_menu"
        name="Manufacturing Checklist Template "
        action="action_sh_manufacturing_checklist_template"
        parent="mrp.menu_mrp_configuration"/>

</odoo>
