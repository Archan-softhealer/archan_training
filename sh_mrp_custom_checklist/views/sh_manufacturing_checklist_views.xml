<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sh_manufacturing_checklist_list" model="ir.ui.view">
        <field name="name">view.sh.manufacturing.checklist.list</field>
        <field name="model">sh.mrp.checklist</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle" nolabel='1'/>
                <field name="name"/>
                <field name="description" />
            </list>
        </field>
    </record>

    <record id="view_sh_manufacturing_checklist_form" model="ir.ui.view">
        <field name="name">view.sh.manufacturing.checklist.form</field>
        <field name="model">sh.mrp.checklist</field>
        <field name="arch" type="xml">
            <form string="Sh Manufacturing Checklist">
                <sheet>
                   <group >
                       <group >
                         <field name="name" />
                         <field name="company"/>
                       </group>
                       <group>
                         <field name="description" />
                       </group>
                   </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sh_manufacturing_checklist_search" model="ir.ui.view">
        <field name="name">view.sh.manufacturing.checklist.search</field>
        <field name="model">sh.mrp.checklist</field>
        <field name="arch" type="xml">
            <search>
            <field name="name"/>
            <field name="description"/>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sh_manufacturing_checklist" model="ir.actions.act_window">
        <field name="name">Manufacturing Checklist</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.mrp.checklist</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="sh_manufacturing_checklist__menu"
        name="Manufacturing Checklist"
        action="action_sh_manufacturing_checklist"
        parent="mrp.menu_mrp_configuration"/>
        
  
</odoo>
