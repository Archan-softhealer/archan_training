<?xml version="1.0" encoding="utf-8"?>
<odoo>
 
 
    <record id="view_sh_import_mrp_custom_checklist_form" model="ir.ui.view">
        <field name="name">view.sh.import.mrp.custom.checklist.form</field>
        <field name="model">sh.import.mrp.custom.checklist</field>
        <field name="arch" type="xml">
            <form string="Import Mrp Custom Checklist">
                <group>
                    <field name="import_type" widget="radio"/>
                    <field name="company"/>
                    <field name="file" filename="file_name"/>
                </group>
                <footer>
                    <button string="Apply" type="object" name="action_import_file" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

 
    <record id="action_sh_import_mrp_custom_checklist" model="ir.actions.act_window">
        <field name="name">Import Mrp Custom Checklist</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sh.import.mrp.custom.checklist</field>
        <field name="view_mode">form</field>    
        <field name="target">new</field>
    </record>
 
   <menuitem
        id="sh_import_mrp_custom_checklist_menu"
        name="Import Mrp Cstom Checklist Menu"
        action="action_sh_import_mrp_custom_checklist"
        parent="mrp.menu_mrp_configuration"/>
 
</odoo>