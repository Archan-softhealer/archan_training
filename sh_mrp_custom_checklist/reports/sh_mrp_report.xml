<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="sh_mrp_report_template" name="Mrp Report Template" inherit_id="mrp.report_mrporder">
        <xpath expr="//div[@t-if='o.move_raw_ids']" position="after">
            <h2>Checklist</h2>
            <p><strong>Completed Checklist :</strong> 
                <t t-esc="o.checklist_completed"/>%
            </p>
            <table class="table table-sm table-bordered" style="width:100%; border-collapse: collapse;">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Date</th>
                        <th>State</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="o.sh_checklist_line" t-as="line">
                        <tr>
                            <td><t t-esc="line.name.name"/></td>
                            <td><t t-esc="line.description"/></td>
                            <td><t t-esc="line.date"/></td>
                            <td><t t-esc="line.state"/></td>
                        </tr>
                    </t>
                </tbody>
            </table>
        </xpath>
    </template>
</odoo>
